generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                     String               @id @default(cuid())
  name                   String
  slug                   String               @unique
  telegramBotToken       String?
  telegramBotId          String?
  telegramBotUsername    String?
  telegramBotName        String?
  telegramDefaultChatId  String?
  telegramWebhookSecret  String?
  telegramConnectedAt    DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  users                  User[]
  deals                  Deal[]
  managerLinks           ManagerLink[]
  auditLogs              AuditLog[]
  emailTemplates         EmailTemplate[]
  telegramTemplates      TelegramTemplate[]
  clientStageMessages    ClientStageMessage[]
  calculatorSettings     CompanyCalculatorSettings?
  dashboardSettings      CompanyDashboardSettings?
  appearanceSettings     CompanyAppearanceSettings?

  @@map("companies")
}

model Role {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String
  passwordHash      String
  roleId            String
  companyId         String
  isPlatformAdmin   Boolean        @default(false)
  telegramChatId    String?
  telegramLinkToken String?        @unique
  telegramLinkTokenExpiresAt DateTime?
  passwordResetTokenHash     String?   @unique
  passwordResetTokenExpiresAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  auditLogs         AuditLog[]
  comments          Comment[]
  deals             Deal[]         @relation("DealManager")
  clientDeal        Deal?          @relation("DealClientUser")
  uploadedDocuments Document[]     @relation("DocumentUploadedBy")
  uploadedMedia     MediaFile[]    @relation("MediaUploadedBy")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  fcmDevices        FcmDevice[]
  stageChanges      StageHistory[] @relation("StageChangedBy")
  createdTasks      Task[]         @relation("TaskCreatedBy")
  updatedAdditionalOptions DealAdditionalOption[] @relation("AdditionalOptionUpdatedBy")
  createdCustomsEstimates DealCustomsEstimate[] @relation("CustomsEstimateCreatedBy")
  calculatorSettings UserCalculatorSettings?
  role              Role           @relation(fields: [roleId], references: [id])
  dealManagerAssignments DealManagerAssignment[] @relation("DealManagerAssignmentUser")
  managerLinksAsA   ManagerLink[]  @relation("ManagerLinkUserA")
  managerLinksAsB   ManagerLink[]  @relation("ManagerLinkUserB")

  @@unique([companyId, email])
  @@index([roleId])
  @@index([companyId])
  @@map("users")
}

model Deal {
  id                 String         @id @default(cuid())
  companyId          String
  clientName         String
  phone              String?
  email              String?
  vin                String
  carBrand           String?
  carModel           String?
  carYear            Int?
  purchasePrice      Decimal?       @db.Decimal(12, 2)
  prepayment         Decimal?       @db.Decimal(12, 2)
  balance            Decimal?       @db.Decimal(12, 2)
  destinationCity    String
  destinationCountry String
  managerId          String?
  clientUserId       String?        @unique
  currentStage       DealStageType
  stageEnteredAt     DateTime
  expectedArrival    DateTime?
  actualArrival      DateTime?
  priority           Int            @default(1)
  inspectionLink     String?
  chinaAutotecaLink  String?
  importProcessEnabled Boolean        @default(false)
  carCarrierDestinationLat Decimal?    @db.Decimal(10, 7)
  carCarrierDestinationLng Decimal?    @db.Decimal(10, 7)
  carCarrierDestinationTitle String     @default("")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  comments           Comment[]
  manager            User?          @relation("DealManager", fields: [managerId], references: [id])
  clientUser         User?          @relation("DealClientUser", fields: [clientUserId], references: [id], onDelete: SetNull)
  documents          Document[]
  media              MediaFile[]
  notifications      Notification[]
  reminders          Reminder[]
  shipment           Shipment?
  stageHistory       StageHistory[]
  tasks              Task[]
  searchProcessEntries SearchProcessEntry[]
  importProcessEntries ImportProcessEntry[]
  carCarrierTrackingPoints CarCarrierTrackingPoint[]
  managerAssignments DealManagerAssignment[]
  additionalOptions    DealAdditionalOption[]
  expenses             DealExpense[]
  customsEstimates     DealCustomsEstimate[]

  @@index([companyId])
  @@index([managerId])
  @@index([clientUserId])
  @@index([currentStage])
  @@index([vin])
  @@index([stageEnteredAt])
  @@index([expectedArrival])
  @@map("deals")
}

model DealManagerAssignment {
  id        String   @id @default(cuid())
  dealId    String
  managerId String
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  manager   User     @relation("DealManagerAssignmentUser", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([dealId, managerId])
  @@index([dealId])
  @@index([managerId])
  @@map("deal_manager_assignments")
}

model StageHistory {
  id          String        @id @default(cuid())
  dealId      String
  fromStage   DealStageType
  toStage     DealStageType
  changedById String
  createdAt   DateTime      @default(now())
  changedBy   User          @relation("StageChangedBy", fields: [changedById], references: [id])
  deal        Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([changedById])
  @@index([createdAt])
  @@map("stage_history")
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  link        String?
  dealId      String
  createdById String
  createdAt   DateTime    @default(now())
  media       MediaFile[]
  createdBy   User        @relation("TaskCreatedBy", fields: [createdById], references: [id])
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([createdById])
  @@map("tasks")
}

model MediaFile {
  id                   String              @id @default(cuid())
  type                 MediaType
  fileName             String
  fileUrl              String
  thumbnailUrl         String?
  size                 Int
  taskId               String?
  dealId               String?
  searchProcessEntryId String?
  importProcessEntryId String?
  carCarrierTrackingPointId String?
  uploadedById         String
  uploadedAt             DateTime            @default(now())
  deal                 Deal?               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  task                 Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  searchProcessEntry   SearchProcessEntry? @relation(fields: [searchProcessEntryId], references: [id], onDelete: Cascade)
  importProcessEntry   ImportProcessEntry? @relation(fields: [importProcessEntryId], references: [id], onDelete: Cascade)
  carCarrierTrackingPoint CarCarrierTrackingPoint? @relation(fields: [carCarrierTrackingPointId], references: [id], onDelete: Cascade)
  uploadedBy           User                @relation("MediaUploadedBy", fields: [uploadedById], references: [id])

  @@index([dealId])
  @@index([taskId])
  @@index([searchProcessEntryId])
  @@index([importProcessEntryId])
  @@index([carCarrierTrackingPointId])
  @@index([uploadedById])
  @@map("media_files")
}

model SearchProcessEntry {
  id               String      @id @default(cuid())
  dealId           String
  description      String      @default("")
  clientFeedback   String?
  clientFeedbackAt DateTime?
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deal             Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  media            MediaFile[]

  @@index([dealId])
  @@index([sortOrder])
  @@map("search_process_entries")
}

model ImportProcessEntry {
  id          String      @id @default(cuid())
  dealId      String
  description String      @default("")
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  media       MediaFile[]

  @@index([dealId])
  @@index([sortOrder])
  @@map("import_process_entries")
}

model CarCarrierTrackingPoint {
  id          String      @id @default(cuid())
  dealId      String
  latitude    Decimal     @db.Decimal(10, 7)
  longitude   Decimal     @db.Decimal(10, 7)
  title       String      @default("")
  description String      @default("")
  recordedAt  DateTime    @default(now())
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  media       MediaFile[]

  @@index([dealId])
  @@index([sortOrder])
  @@map("car_carrier_tracking_points")
}

model DealAdditionalOption {
  id          String   @id @default(cuid())
  dealId      String
  optionKey   String
  label       String?
  groupId     String?
  isCustom    Boolean  @default(false)
  checked     Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("AdditionalOptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([dealId, optionKey])
  @@index([dealId])
  @@map("deal_additional_options")
}

model DealExpense {
  id          String   @id @default(cuid())
  dealId      String
  description String   @default("")
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_expenses")
}

model DealCustomsEstimate {
  id           String   @id @default(cuid())
  dealId       String
  createdById  String
  input        Json
  result       Json
  totalWithCar Decimal  @db.Decimal(14, 2)
  note         String?
  createdAt    DateTime @default(now())
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("CustomsEstimateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt])
  @@index([createdById])
  @@map("deal_customs_estimates")
}

model UserCalculatorSettings {
  userId        String   @id
  presets       Json     @default("[]")
  exportLogoUrl String?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_calculator_settings")
}

model CompanyCalculatorSettings {
  companyId     String   @id
  expenseItems  Json     @default("[]")
  customOrigins Json     @default("[]")
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_calculator_settings")
}

model CompanyDashboardSettings {
  companyId String   @id
  layout    Json     @default("[]")
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_dashboard_settings")
}

model CompanyAppearanceSettings {
  companyId      String   @id
  presetId       String   @default("classic")
  customBrandHsl String?
  logoUrl        String?
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_appearance_settings")
}

model Document {
  id           String         @id @default(cuid())
  dealId       String
  type         DocumentType
  status       DocumentStatus
  fileUrl      String?
  uploadedById String?
  uploadedAt   DateTime?
  deal         Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedBy   User?          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@unique([dealId, type])
  @@index([dealId])
  @@index([status])
  @@map("documents")
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  dealId    String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([authorId])
  @@map("comments")
}

model Shipment {
  id               String    @id @default(cuid())
  dealId           String    @unique
  purchaseDate     DateTime?
  shippingDate     DateTime?
  expectedArrival  DateTime?
  actualArrival    DateTime?
  customsCompleted DateTime?
  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model Reminder {
  id        String   @id @default(cuid())
  dealId    String
  title     String
  dueDate   DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([dueDate])
  @@index([completed])
  @@map("reminders")
}

model Notification {
  id        String           @id @default(cuid())
  dealId    String?
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  deal      Deal?            @relation(fields: [dealId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dealId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model FcmDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_devices")
}

model ManagerLink {
  id          String   @id @default(cuid())
  companyId   String
  userAId     String
  userBId     String
  createdById String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userA       User     @relation("ManagerLinkUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User     @relation("ManagerLinkUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([companyId])
  @@index([userAId])
  @@index([userBId])
  @@map("manager_links")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  entity    String
  entityId  String
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailTemplate {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  name        String
  subject     String
  textBody    String   @db.Text
  htmlTitle   String
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@map("email_templates")
}

model TelegramTemplate {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  name        String
  textBody    String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@map("telegram_templates")
}

model ClientStageMessage {
  id          String        @id @default(cuid())
  companyId   String
  stage       DealStageType
  textBody    String        @db.Text
  updatedAt   DateTime      @updatedAt
  updatedById String?
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, stage])
  @@index([companyId])
  @@map("client_stage_messages")
}

enum DealStageType {
  LEADS
  SEARCH
  INVOICE
  PREPARATION
  CUSTOMS
  TRANSPORT
  DELIVERY
}

enum MediaType {
  PHOTO
  VIDEO
}

enum DocumentType {
  SEARCH_AGREEMENT
  PASSPORT
  PASSPORT_2
  PASSPORT_NOTARIZED_COPY
  PASSPORT_NOTARIZED_COPY_2
  INN
  SNILS
  PAYMENT
  INVOICE
  CONTRACT
  CUSTOMS_DUTY
  CUSTOMS_DUTY_RECEIPT
  BROKER_SERVICES_RECEIPT
  BROKER_PAYMENT_RECEIPT
  EPTS
  PTD
  SBKTS
}

enum DocumentStatus {
  MISSING
  RECEIVED
  VERIFIED
}

enum NotificationType {
  SYSTEM
  EMAIL
  TELEGRAM
  PUSH
}
